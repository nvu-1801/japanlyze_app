// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. USER & AUTHENTICATION
// ==========================================

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String?
  password            String?
  avatar              String?
  role                String               @default("user")
  isPremium           Boolean              @default(false)
  analysisUsage       Int                  @default(0)
  provider            String               @default("email")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Relations
  decks               Deck[]
  exerciseProgress    ExerciseProgress[]
  payments            Payment[]
  translationHistory  TranslationHistory[]
  testResults         TestResult[]

  // Gamification
  onboardingCompleted Boolean              @default(false)
  currentLevel        String?
  currentPhase        Int                  @default(1)

  progress            UserProgress[]
}

model UserProgress {
  id          String   @id @default(uuid())
  userId      String
  questId     String
  completedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
}

// ==========================================
// 2. PAYMENT
// ==========================================

model Payment {
  id        String   @id @default(uuid())
  orderCode Int      @unique
  amount    Int
  status    String
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 3. FLASHCARD SYSTEM
// ==========================================

model Deck {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  cards       Card[]
}

model Card {
  id        String   @id @default(uuid())
  front     String
  back      String
  example   String?
  isLearned Boolean  @default(false)
  createdAt DateTime @default(now())

  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

// ==========================================
// 4. TRANSLATION & DICTIONARY
// ==========================================

model TranslationHistory {
  id         String   @id @default(uuid())
  sourceText String
  targetText String
  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DictionaryEntry {
  id        String   @id @default(uuid())
  lang      String   @default("ja")
  lemma     String
  reading   String?
  romaji    String?
  posTag    String
  meaningVi String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examples  ExampleSentence[]
}

model ExampleSentence {
  id        String          @id @default(uuid())
  jp        String
  romaji    String?
  vi        String?
  createdAt DateTime        @default(now())

  entryId   String
  entry     DictionaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

// ==========================================
// 5. EXERCISE PROGRESS
// ==========================================

model ExerciseProgress {
  id          String   @id @default(uuid())
  exerciseId  String
  score       Int
  completedAt DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 6. MOCK TEST SYSTEM
// ==========================================

model MockTest {
  id          String     @id @default(uuid())
  title       String
  level       String
  duration    Int
  isPremium   Boolean    @default(false)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions   Question[]
  testResults TestResult[]
}

model Question {
  id            String   @id @default(uuid())
  content       String
  imageUrl      String?
  audioUrl      String?
  type          String
  options       String[]
  correctAnswer Int
  explanation   String?

  testId        String
  test          MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model TestResult {
  id             String   @id @default(uuid())
  score          Int
  totalQuestions Int
  answers        Json
  completedAt    DateTime @default(now())

  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  testId         String
  test           MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)
}